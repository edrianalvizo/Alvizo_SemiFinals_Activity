import math
import sys
import pygame

W, H, FPS = 800, 600, 60

pygame.init()
screen = pygame.display.set_mode((W, H))
pygame.display.set_caption('Activity 1: 2D Animation, Tweening & Morphing Engine')
clock = pygame.time.Clock()
font = pygame.font.Font(None, 28)

MODE_TWEEN, MODE_MORPH, MODE_DYNAMICS = 1, 2, 3
MODE_NAMES = {1: 'Tweening', 2: 'Morphing', 3: 'Dynamics'}


# ---------------------------------------------------------------- math helpers
def lerp(a, b, t):
    """Scalar linear interpolation: (1 - t) * a + t * b."""
    return a + (b - a) * t


def lerp_point(p1, p2, t):
    """P(t) = (1 - t) * P_start + t * P_end for 2D points."""
    return (lerp(p1[0], p2[0], t), lerp(p1[1], p2[1], t))


def ease_in(t):
    return t * t


def ease_out(t):
    return 1 - (1 - t) * (1 - t)


def ease_in_out(t):
    """Smoothstep: slow start, fast middle, slow end."""
    return t * t * (3 - 2 * t)


# ------------------------------------------------------ Task 1.1: tweening
PATH = [(80, 450), (220, 150), (400, 400), (580, 120), (720, 380)]
PATH_FRAMES = 6 * FPS  # whole path takes 6 seconds at 60 FPS


def path_position(frame, use_easing):
    """In-between position along a multi-point path for a given frame."""
    t_global = (frame % PATH_FRAMES) / PATH_FRAMES
    segments = len(PATH) - 1
    s = t_global * segments
    i = min(int(s), segments - 1)
    local_t = s - i
    if use_easing:
        local_t = ease_in_out(local_t)
    return lerp_point(PATH[i], PATH[i + 1], local_t)


def draw_tween(frame, use_easing):
    pygame.draw.lines(screen, (90, 90, 110), False, PATH, 2)
    for p in PATH:  # keyframes
        pygame.draw.circle(screen, (230, 200, 60), p, 8, 2)
    x, y = path_position(frame, use_easing)
    pygame.draw.circle(screen, (60, 170, 255), (int(x), int(y)), 18)
    label = 'ease-in/ease-out' if use_easing else 'linear (LERP)'
    return f'Interpolation: {label}  (E to toggle)'


POLY_START = [(200, 100), (250, 200), (300, 300), (100, 300)]   # triangle
POLY_END = [(150, 100), (350, 120), (320, 320), (120, 300)]     # quadrilateral
MORPH_OFFSET = (200, 80)
MORPH_PERIOD = 4 * FPS


def shift(points, offset):
    return [(x + offset[0], y + offset[1]) for x, y in points]


def draw_morph(frame):
    u = (frame % MORPH_PERIOD) / MORPH_PERIOD
    t = 2 * u if u < 0.5 else 2 - 2 * u      
    t = ease_in_out(t)
    current = [lerp_point(a, b, t) for a, b in zip(POLY_START, POLY_END)]
    pygame.draw.polygon(screen, (90, 90, 110), shift(POLY_START, MORPH_OFFSET), 1)
    pygame.draw.polygon(screen, (90, 90, 110), shift(POLY_END, MORPH_OFFSET), 1)
    pts = shift(current, MORPH_OFFSET)
    pygame.draw.polygon(screen, (80, 200, 120), pts)
    pygame.draw.polygon(screen, (255, 255, 255), pts, 2)
    for p in pts:
        pygame.draw.circle(screen, (255, 120, 80), (int(p[0]), int(p[1])), 5)
    return f'Triangle (4 verts, one split) -> quad,  t = {t:.2f}'


GRAVITY = 0.5
RESTITUTION = 0.78
FLOOR_Y = 500
BALL_R = 20


class Ball:
    def __init__(self):
        self.reset()

    def reset(self):
        self.x, self.y = 100.0, 100.0
        self.vx, self.vy = 4.0, 0.0
        self.resting = False
        self.trail = []

    def update(self, dt=1.0):
        """Euler integration: y += v*dt ; v += g*dt ; bounce: v = -e*v."""
        if self.resting:
            self.vx *= 0.98
            self.x += self.vx * dt
            if abs(self.vx) < 0.05:
                self.vx = 0.0
        else:
            self.x += self.vx * dt
            self.y += self.vy * dt
            self.vy += GRAVITY * dt
        if self.x - BALL_R < 0:
            self.x, self.vx = BALL_R, -self.vx
        elif self.x + BALL_R > W:
            self.x, self.vx = W - BALL_R, -self.vx
        if self.y + BALL_R >= FLOOR_Y:
            self.y = FLOOR_Y - BALL_R
            self.vy = -RESTITUTION * self.vy
            self.vx *= 0.995                       
            if abs(self.vy) < 1.0:                 
                self.vy, self.resting = 0.0, True
        self.trail.append((int(self.x), int(self.y)))
        self.trail = self.trail[-40:]

    def draw(self):
        for i, p in enumerate(self.trail):
            r = max(2, int(BALL_R * i / len(self.trail) * 0.6))
            pygame.draw.circle(screen, (70, 70, 100), p, r)
        pygame.draw.circle(screen, (240, 90, 90), (int(self.x), int(self.y)), BALL_R)


def draw_floor():
    pygame.draw.line(screen, (200, 200, 200), (0, FLOOR_Y), (W, FLOOR_Y), 3)


def main():
    mode, frame, easing = MODE_TWEEN, 0, True
    ball = Ball()
    while True:
        # process input
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    pygame.quit()
                    sys.exit()
                elif event.key in (pygame.K_1, pygame.K_2, pygame.K_3):
                    mode = {pygame.K_1: 1, pygame.K_2: 2, pygame.K_3: 3}[event.key]
                    frame = 0
                    ball.reset()
                elif event.key == pygame.K_e:
                    easing = not easing
                elif event.key == pygame.K_r:
                    ball.reset()

        # update state
        frame += 1
        if mode == MODE_DYNAMICS:
            ball.update()

        # render
        screen.fill((20, 20, 30))
        if mode == MODE_TWEEN:
            info = draw_tween(frame, easing)
        elif mode == MODE_MORPH:
            info = draw_morph(frame)
        else:
            draw_floor()
            ball.draw()
            info = f'vy = {ball.vy:6.2f}   e = {RESTITUTION}   g = {GRAVITY}  (R to reset)'
        hud = f'[{mode}] {MODE_NAMES[mode]}   |   {info}'
        screen.blit(font.render(hud, True, (230, 230, 230)), (10, 10))
        screen.blit(font.render('Keys: 1 Tween  2 Morph  3 Dynamics  ESC quit',
                                True, (150, 150, 160)), (10, H - 30))
        pygame.display.flip()

        # regulate FPS
        clock.tick(FPS)


if __name__ == '__main__':
    main()
