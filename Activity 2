import random
import sys
import pygame

pygame.init()
SCREEN_WIDTH, SCREEN_HEIGHT = 800, 600
FPS = 60
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption('Activity 2: Sprite System & Collision Arena')
clock = pygame.time.Clock()
font = pygame.font.Font(None, 36)       
big_font = pygame.font.Font(None, 72)

NUM_OBSTACLES = 6
START_LIVES = 3
MAX_HEALTH = 100
HIT_DAMAGE = 34
INVULN_FRAMES = 60


class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((40, 40), pygame.SRCALPHA)
        pygame.draw.circle(self.image, (44, 94, 138), (20, 20), 20)
        self.rect = self.image.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2))
        self.speed = 5
        self.invuln = 0                    

    def update(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT]:
            self.rect.x -= self.speed
        if keys[pygame.K_RIGHT]:
            self.rect.x += self.speed
        if keys[pygame.K_UP]:
            self.rect.y -= self.speed
        if keys[pygame.K_DOWN]:
            self.rect.y += self.speed
        # strict boundary clamping
        self.rect.clamp_ip(screen.get_rect())
        if self.invuln > 0:
            self.invuln -= 1


class Target(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((30, 30))
        self.image.fill((220, 50, 50))
        self.rect = self.image.get_rect(topleft=(random.randint(50, 720),
                                                 random.randint(50, 520)))


class Obstacle(pygame.sprite.Sprite):
    """Roaming obstacle that bounces off the screen edges."""
    def __init__(self, avoid_rect=None):
        super().__init__()
        size = random.randint(30, 55)
        self.image = pygame.Surface((size, size))
        self.image.fill((140, 140, 155))
        pygame.draw.rect(self.image, (200, 200, 210), self.image.get_rect(), 3)
        self.rect = self.image.get_rect()
        # respawn 
        while True:
            self.rect.topleft = (random.randint(0, SCREEN_WIDTH - size),
                                 random.randint(0, SCREEN_HEIGHT - size))
            if avoid_rect is None or not self.rect.inflate(160, 160).colliderect(avoid_rect):
                break
        self.vx = random.choice([-1, 1]) * random.randint(2, 4)
        self.vy = random.choice([-1, 1]) * random.randint(2, 4)

    def update(self):
        self.rect.x += self.vx
        self.rect.y += self.vy
        if self.rect.left < 0 or self.rect.right > SCREEN_WIDTH:
            self.vx = -self.vx
            self.rect.clamp_ip(screen.get_rect())
        if self.rect.top < 0 or self.rect.bottom > SCREEN_HEIGHT:
            self.vy = -self.vy
            self.rect.clamp_ip(screen.get_rect())


class Particle(pygame.sprite.Sprite):
    """Translucent impact particle. update() only changes state (position, life);
    the alpha is applied by the render stage."""
    def __init__(self, pos, color):
        super().__init__()
        self.radius = random.randint(4, 9)
        self.image = pygame.Surface((self.radius * 2, self.radius * 2), pygame.SRCALPHA)
        pygame.draw.circle(self.image, color, (self.radius, self.radius), self.radius)
        self.rect = self.image.get_rect(center=pos)
        self.pos = pygame.math.Vector2(pos)
        self.vel = pygame.math.Vector2(random.uniform(-4, 4), random.uniform(-4, 4))
        self.max_life = random.randint(25, 45)
        self.life = self.max_life

    @property
    def alpha(self):
        return int(255 * self.life / self.max_life)

    def update(self):
        self.pos += self.vel
        self.vel *= 0.95
        self.rect.center = (round(self.pos.x), round(self.pos.y))
        self.life -= 1
        if self.life <= 0:
            self.kill()


def burst(group, pos, color, n=18):
    for _ in range(n):
        group.add(Particle(pos, color))


def draw_hud(score, lives, health, fps, game_over):
    screen.blit(font.render(f'Score: {score}', True, (255, 255, 255)), (10, 10))
    screen.blit(font.render(f'Lives: {lives}', True, (255, 255, 255)), (10, 45))
    screen.blit(font.render(f'FPS: {fps:.0f}', True, (180, 255, 180)), (SCREEN_WIDTH - 130, 10))
    # health bar
    pygame.draw.rect(screen, (60, 60, 60), (10, 85, 200, 18))
    pygame.draw.rect(screen, (80, 200, 90), (10, 85, int(200 * health / MAX_HEALTH), 18))
    pygame.draw.rect(screen, (255, 255, 255), (10, 85, 200, 18), 2)
    if game_over:
        msg = big_font.render('GAME OVER', True, (255, 80, 80))
        sub = font.render('Press R to restart', True, (255, 255, 255))
        screen.blit(msg, msg.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 20)))
        screen.blit(sub, sub.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 30)))


def new_game():
    player = Player()
    obstacles = pygame.sprite.Group(Obstacle(player.rect) for _ in range(NUM_OBSTACLES))
    targets = pygame.sprite.Group(Target())
    particles = pygame.sprite.Group()
    player_group = pygame.sprite.GroupSingle(player)
    return player, player_group, obstacles, targets, particles


def main():
    player, player_group, obstacles, targets, particles = new_game()
    score, lives, health, game_over = 0, START_LIVES, MAX_HEALTH, False

    while True:
        # input
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    pygame.quit()
                    sys.exit()
                if event.key == pygame.K_r and game_over:
                    player, player_group, obstacles, targets, particles = new_game()
                    score, lives, health, game_over = 0, START_LIVES, MAX_HEALTH, False

        # game state 
        if not game_over:
            player_group.update()
            obstacles.update()
            targets.update()

            # sprite v group
            for _ in pygame.sprite.spritecollide(player, targets, True):
                score += 10
                burst(particles, player.rect.center, (255, 230, 80))
                targets.add(Target())

            # sprite v group 2
            hit = pygame.sprite.spritecollideany(player, obstacles, pygame.sprite.collide_rect)
            if hit and player.invuln == 0:
                health -= HIT_DAMAGE
                player.invuln = INVULN_FRAMES
                burst(particles, hit.rect.center, (255, 90, 90), 24)
                hit.kill()
                obstacles.add(Obstacle(player.rect))      # respawn
                if health <= 0:
                    lives -= 1
                    health = MAX_HEALTH
                    if lives <= 0:
                        game_over = True
        particles.update()

        # render
        screen.fill((18, 18, 28))
        targets.draw(screen)
        obstacles.draw(screen)
        for p in particles:                      # render time
            p.image.set_alpha(p.alpha)
        particles.draw(screen)
        # blink the player while invulnerable
        if player.invuln == 0 or (player.invuln // 5) % 2 == 0:
            player_group.draw(screen)
        draw_hud(score, lives, health, clock.get_fps(), game_over)
        pygame.display.flip()

        # regulate FPS
        clock.tick(FPS)


if __name__ == '__main__':
    main()
