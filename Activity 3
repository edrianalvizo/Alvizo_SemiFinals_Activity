import math
import random
import time


class Point3D:
    def __init__(self, x: float, y: float, z: float):
        self.x, self.y, self.z = x, y, z

    # ---- vector arithmetic (Task 3.1)
    def __add__(self, o): return Point3D(self.x + o.x, self.y + o.y, self.z + o.z)
    def __sub__(self, o): return Point3D(self.x - o.x, self.y - o.y, self.z - o.z)
    def __mul__(self, k: float): return Point3D(self.x * k, self.y * k, self.z * k)
    __rmul__ = __mul__
    def __neg__(self): return Point3D(-self.x, -self.y, -self.z)
    def __eq__(self, o): return (self.x, self.y, self.z) == (o.x, o.y, o.z)
    def __repr__(self): return f'({self.x:g}, {self.y:g}, {self.z:g})'

    def dot(self, o) -> float:
        return self.x * o.x + self.y * o.y + self.z * o.z

    def cross(self, o) -> 'Point3D':
        return Point3D(self.y * o.z - self.z * o.y,
                       self.z * o.x - self.x * o.z,
                       self.x * o.y - self.y * o.x)

    def magnitude_sq(self) -> float:
        return self.dot(self)

    def magnitude(self) -> float:
        return math.sqrt(self.magnitude_sq())

    def distance_to(self, other: 'Point3D') -> float:
        return math.sqrt((self.x - other.x)**2 + (self.y - other.y)**2 + (self.z - other.z)**2)

    def distance_sq_to(self, other: 'Point3D') -> float:
        return (self - other).magnitude_sq()

    def octant(self) -> int:
        """Octant 1-8 (right-hand rule). Octant I is (+,+,+); 0 if on a coordinate plane.
        Order: I(+,+,+) II(-,+,+) III(-,-,+) IV(+,-,+) V..VIII same below the xy-plane."""
        if self.x == 0 or self.y == 0 or self.z == 0:
            return 0
        base = {(1, 1): 1, (-1, 1): 2, (-1, -1): 3, (1, -1): 4}[
            (1 if self.x > 0 else -1, 1 if self.y > 0 else -1)]
        return base if self.z > 0 else base + 4


class Sphere3D:
    def __init__(self, center: Point3D, radius: float):
        self.center = center
        self.radius = radius

    def contains_point(self, p: Point3D) -> bool:
        return self.center.distance_sq_to(p) <= self.radius ** 2

    def intersects_sphere(self, other: 'Sphere3D') -> bool:
        # optimisation: compare squared distance, avoid sqrt
        return self.center.distance_sq_to(other.center) <= (self.radius + other.radius) ** 2

    @staticmethod
    def from_general_form(D: float, E: float, F: float, G: float) -> 'Sphere3D':
        """x^2 + y^2 + z^2 + Dx + Ey + Fz + G = 0 -> complete the squares."""
        c = Point3D(-D / 2, -E / 2, -F / 2)
        r_sq = c.magnitude_sq() - G
        if r_sq < 0:
            raise ValueError('not a real sphere (r^2 < 0)')
        return Sphere3D(c, math.sqrt(r_sq))


class AABB:
    def __init__(self, min_pt: Point3D, max_pt: Point3D):
        self.min_pt = min_pt
        self.max_pt = max_pt

    def intersects(self, other: 'AABB') -> bool:
        return (self.min_pt.x <= other.max_pt.x and self.max_pt.x >= other.min_pt.x and
                self.min_pt.y <= other.max_pt.y and self.max_pt.y >= other.min_pt.y and
                self.min_pt.z <= other.max_pt.z and self.max_pt.z >= other.min_pt.z)

    def contains_point(self, p: Point3D) -> bool:
        return (self.min_pt.x <= p.x <= self.max_pt.x and
                self.min_pt.y <= p.y <= self.max_pt.y and
                self.min_pt.z <= p.z <= self.max_pt.z)

    def center(self) -> Point3D:
        return (self.min_pt + self.max_pt) * 0.5

    def bounding_sphere(self) -> Sphere3D:
        """Smallest sphere enclosing the box (radius = half the diagonal)."""
        return Sphere3D(self.center(), (self.max_pt - self.min_pt).magnitude() / 2)


