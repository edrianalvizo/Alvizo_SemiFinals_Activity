def verify_example_3():
    P, Q = Point3D(2, -1, 7), Point3D(1, -3, 5)
    d = P.distance_to(Q)
    print('Example 3: distance P', P, 'to Q', Q, '=', d)
    assert math.isclose(d, 3.0), 'expected d = 3.0'
    print('  OK: d = 3.0')


def verify_example_5():
    # x^2 + y^2 + z^2 + 4x - 6y + 2z + 6 = 0
    # (x+2)^2 + (y-3)^2 + (z+1)^2 = 4 + 9 + 1 - 6 = 8
    s = Sphere3D.from_general_form(4, -6, 2, 6)
    print(f'Example 5: center = {s.center}, radius = {s.radius:.3f}')
    assert s.center == Point3D(-2, 3, -1)
    assert math.isclose(s.radius, math.sqrt(8))
    print('  OK: center (-2, 3, -1), radius sqrt(8) = 2.828')


def random_object(world=100.0):
    lo = Point3D(*(random.uniform(0, world) for _ in range(3)))
    size = Point3D(*(random.uniform(2, 15) for _ in range(3)))
    box = AABB(lo, lo + size)
    return box, box.bounding_sphere()


def broad_phase_test(n=100, seed=42):
    random.seed(seed)
    objects = [random_object() for _ in range(n)]
    pairs = n * (n - 1) // 2

    # AABBs 
    t0 = time.perf_counter()
    aabb_hits = {(i, j) for i in range(n) for j in range(i + 1, n)
                 if objects[i][0].intersects(objects[j][0])}
    t_aabb = time.perf_counter() - t0

    # brute force 
    t0 = time.perf_counter()
    sphere_hits = {(i, j) for i in range(n) for j in range(i + 1, n)
                   if objects[i][1].intersects_sphere(objects[j][1])}
    t_sphere = time.perf_counter() - t0

    # two-stage
    t0 = time.perf_counter()
    staged = {(i, j) for (i, j) in sphere_hits if objects[i][0].intersects(objects[j][0])}
    t_staged = time.perf_counter() - t0

    assert aabb_hits <= sphere_hits
    assert staged == aabb_hits

    print(f'Broad phase: {n} objects, {pairs} candidate pairs')
    print(f'  AABB overlaps   : {len(aabb_hits):4d}   ({t_aabb * 1000:.2f} ms)')
    print(f'  Sphere overlaps : {len(sphere_hits):4d}   ({t_sphere * 1000:.2f} ms)')
    print(f'  Sphere -> AABB  : {len(staged):4d}   (AABB tests run on only '
          f'{len(sphere_hits)} of {pairs} pairs, {t_staged * 1000:.2f} ms)')
    false_positives = len(sphere_hits) - len(aabb_hits)
    print(f'  Sphere false positives rejected by AABB stage: {false_positives}')


def vector_demo():
    a, b = Point3D(1, 0, 0), Point3D(0, 1, 0)
    print('Vector demo: a x b =', a.cross(b), ', a . b =', a.dot(b))
    for p in (Point3D(1, 2, 3), Point3D(-1, 2, 3), Point3D(-1, -2, 3), Point3D(1, -2, 3),
              Point3D(1, 2, -3), Point3D(-1, 2, -3), Point3D(-1, -2, -3), Point3D(1, -2, -3)):
        print(f'  {p} -> octant {p.octant()}')


if __name__ == '__main__':
    verify_example_3()
    verify_example_5()
    vector_demo()
    broad_phase_test()
